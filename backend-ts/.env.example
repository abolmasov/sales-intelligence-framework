# Database (PostgreSQL — use docker compose at repo root)
URL=postgresql://postgres:postgres@localhost:5432/sales_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_intelligence

# Server Configuration
PORT=3001
NODE_ENV=development

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Set MOCK_LLM=true to run without OpenAI (deterministic demo responses)
MOCK_LLM=true

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# NewsData.io API (Optional - for news intelligence)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Microsoft OAuth 2.0 and Graph API Configuration
MS_CLIENT_ID=your_microsoft_client_id
MS_CLIENT_SECRET=your_microsoft_client_secret
MS_TENANT_ID=your_microsoft_tenant_id
MS_REDIRECT_URI=http://localhost:3001/auth/callback
FRONTEND_URL=http://localhost:3000

# Legacy Azure naming (for compatibility)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Encryption Key for API Keys (32 bytes, base64 encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_encryption_key_here

# CORS Settings
CORS_ORIGIN=http://localhost:3000
JWT_SECRET = your jwt secret

# Transcript encryption key — AES-256-GCM, 32 bytes as hex (64 chars)
# Generate with: openssl rand -hex 32
# If not set, transcripts are stored unencrypted (not recommended for production)
TRANSCRIPT_ENCRYPTION_KEY=your_64_char_hex_key_here

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# AWS S3 Storage (PPTX exports)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Optional if you use temporary credentials
AWS_SESSION_TOKEN=your_aws_session_token
S3_PPTX_BUCKET=your_pptx_bucket_name
S3_PPTX_PREFIX=sales-intelligence/pptx
# Signed download links will expire after this many seconds
S3_PPTX_SIGNED_URL_TTL=900

# Optional: SQS queue for long-running proposal jobs
PROPOSAL_JOB_QUEUE_URL=

# Sales Intelligence Search API (replaces legacy KMHub streaming integration)
# Base URL of optional internal knowledge API (leave blank for offline demo)
SALES_INTELLIGENCE_API_URL=
# Static API key — must match SALES_INTELLIGENCE_KEY on the Sales Intelligence server
SALES_INTELLIGENCE_KEY=your_sales_intelligence_key_here

# Error Monitoring (Sentry) — optional but recommended for production
# Get your DSN from https://sentry.io
SENTRY_DSN=
