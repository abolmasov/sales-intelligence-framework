model Workspace {
  workspaceId       String    @id @map("workspace_id")
  name              String
  description       String?
  status            String    @default("draft")

  // Workspace type
  workspaceType     String    @default("workshop_analysis") @map("workspace_type")
  sourceDocuments   String?   @map("source_documents")

  // Transcript data
  transcriptText    String?   @map("transcript_text")
  transcriptExcerpt String?   @map("transcript_excerpt")
  workshopDate      DateTime? @map("workshop_date")
  workshopDuration  Int?      @map("workshop_duration")
  clientName        String?   @map("client_name")

  // Analysis stage
  analysisStatus    String    @default("pending") @map("analysis_status")
  analysisResult    String?   @map("analysis_result")

  // Miro board stage
  miroStatus        String    @default("pending") @map("miro_status")
  miroBoardId       String?   @map("miro_board_id")
  miroBoardUrl      String?   @map("miro_board_url")
  miroSnapshot      String?   @map("miro_snapshot")

  // PPTX stage
  pptxStatus        String    @default("pending") @map("pptx_status")
  pptxJobId         String?   @unique @map("pptx_job_id")

  // ── Engagement lifecycle (4-stage) ──────────────────────────────────────
  // Stage tracking
  engagementStage   String?   @map("engagement_stage")  // pre_workshop | workshop_prep | workshop | post_workshop

  // Stage 1 – Client Intelligence & Survey
  workshopFocus        String    @default("ITSM") @map("workshop_focus")  // ITSM | HRSD | HRSD_ITSM
  clientIntelligence   String?   @map("client_intelligence")    // JSON: ClientIntelligenceResult
  preworkshopSurvey    String?   @map("preworkshop_survey")     // JSON: PreWorkshopSurvey (generated questions)
  surveyDocUrl         String?   @map("survey_doc_url")

  // Stage 2 – Workshop Preparation (re-runnable)
  surveyResponses          String?   @map("survey_responses")           // JSON: ingested client answers
  workshopPrepMiroId       String?   @map("workshop_prep_miro_id")
  workshopPrepMiroUrl      String?   @map("workshop_prep_miro_url")
  workshopPrepMiroSnapshot String?   @map("workshop_prep_miro_snapshot") // JSON
  workshopPrepMiroStatus   String?   @default("pending") @map("workshop_prep_miro_status")
  workshopPrepDeckUrl      String?   @map("workshop_prep_deck_url")
  workshopPrepPptxStatus   String?   @default("pending") @map("workshop_prep_pptx_status")
  workshopPrepPptxJobId    String?   @map("workshop_prep_pptx_job_id")
  workshopPrepPptxStep     String?   @map("workshop_prep_pptx_step")  // current generation step key

  // Stage 3 – Live Workshop (agent mapping)
  workshopNotes       String?   @map("workshop_notes")         // freetext from meeting
  miroContextItems    String?   @map("miro_context_items")     // JSON: synced cards from Miro
  agentMappings       String?   @map("agent_mappings")         // JSON: AgentMapping[]
  agentMappingStatus  String?   @default("pending") @map("agent_mapping_status")
  workshopPersonas    String?   @map("workshop_personas")      // JSON: WorkshopPersona[]
  workshopPainPoints  String?   @map("workshop_pain_points")   // JSON: WorkshopPainPoint[]
  personaMappings     String?   @map("persona_mappings")       // JSON: PersonaMapping[]
  personaMappingStatus String?  @default("pending") @map("persona_mapping_status")

  // ── Metadata ─────────────────────────────────────────────────────────────
  errorMessage      String?   @map("error_message")
  pipelineLog       String?   @map("pipeline_log")
  requestedBy       String?   @map("requested_by")
  requestedByEmail  String?   @map("requested_by_email")
  accountId         String?   @map("account_id")
  dealId            String?   @map("deal_id")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")

  // Relations
  pptxJob           PptxJob?  @relation("WorkspacePptxJob", fields: [pptxJobId], references: [jobId])
  account           Account?  @relation(fields: [accountId], references: [accountId])
  deal              Deal?     @relation(fields: [dealId], references: [dealId])
  isSaved           Boolean   @default(false) @map("is_saved")

  @@index([status])
  @@index([requestedBy])
  @@index([clientName])
  @@index([accountId])
  @@index([dealId])
  @@index([createdAt])
  @@index([isSaved, createdAt])
  @@index([workspaceType])
  @@map("workspaces")
}

